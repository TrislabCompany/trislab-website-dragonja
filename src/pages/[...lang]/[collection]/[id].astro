---
import { render, type CollectionEntry } from "astro:content";
import Photo from "../../../components/Photo.astro";
import PhotoCredits from "../../../components/PhotoCredits.astro";
import { localizedPath, t, type Lang } from "../../../i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { entrySlug } from "../../../lib/content";
import { collectionSettings, itemPaths, type ItemCollection } from "../../../lib/items";
import { attractionPoints } from "../../../lib/places";

export const getStaticPaths = itemPaths;

const { entry, lang, collection, available } = Astro.props as {
  entry: CollectionEntry<ItemCollection>;
  lang: Lang;
  collection: ItemCollection;
  available: Lang[];
};
const settings = collectionSettings(collection);
const { Content } = await render(entry);
const { title, summary, kind, photo, where, sources } = entry.data;
const place = {
  type: "TouristAttraction" as const,
  name: title,
  description: summary,
  url: localizedPath(lang, `/${collection}/${entrySlug(entry)}`),
  point: attractionPoints[entrySlug(entry)],
};
---

<BaseLayout title={title} description={summary} lang={lang} available={available} share={photo} place={place}>
  <article class="item">
    <div class="item-photo">
      <Photo id={photo} lang={lang} widths={[640, 1024, 1440]} sizes="(min-width: 72rem) 70rem, 100vw" eager />
    </div>
    <div class="prose">
      <p class="eyebrow">
        <a href={localizedPath(lang, `/${collection}`)}>{settings.title[lang]}</a> · {t(lang, `kind.${kind}`)}
      </p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <dl class="facts">
        <dt>{t(lang, "item.where")}</dt>
        <dd>{where}</dd>
      </dl>
      <Content />
      <h2 class="sources-title">{t(lang, "item.sources")}</h2>
      <ul class="sources">
        {
          sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
  <PhotoCredits ids={[photo]} lang={lang} />
</BaseLayout>
