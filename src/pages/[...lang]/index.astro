---
import ItemCard from "../../components/ItemCard.astro";
import Photo from "../../components/Photo.astro";
import PhotoCredits from "../../components/PhotoCredits.astro";
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { icons } from "../../lib/icons";
import { entrySlug } from "../../lib/content";
import { sortedItems } from "../../lib/items";
import site from "../../site.config";
import { home, sources } from "../../texts/home";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const text = home[lang];
const attractions = localizedPath(lang, "/attractions");
const visit = localizedPath(lang, "/visit-us");
const ways = [
  { kind: "nature", photo: "valley-view", text: text.ways.nature },
  { kind: "culture", photo: "stone-house", text: text.ways.culture },
  { kind: "activity", photo: "parenzana", text: text.ways.activity },
] as const;
// A photo shows once per page: a featured attraction whose photo is already
// on the page is skipped (scripts/check-design.mjs fails the build otherwise).
const fixed = ["valley-cascade", ...ways.map((way) => way.photo), "border-view", "river-summer"];
const featured = (await sortedItems("attractions", lang))
  .filter((entry) => entry.data.featured && !fixed.includes(entry.data.photo))
  .slice(0, 6);
const getting = [
  { ...text.getting.car, icon: icons.car },
  { ...text.getting.bike, icon: icons.bike },
  { ...text.getting.foot, icon: icons.foot },
];
// The photos on this page, for the credits at its end.
const all = await sortedItems("attractions", lang);
const place = {
  type: "TouristDestination" as const,
  name: text.hero.title,
  description: site.description[lang],
  url: localizedPath(lang),
  includes: all.map((entry) => ({ name: entry.data.title, url: localizedPath(lang, `/attractions/${entrySlug(entry)}`) })),
};
const shown = [...fixed, ...featured.map((entry) => entry.data.photo)];
---

<BaseLayout title={site.name} lang={lang} wide place={place}>
  <section class="hero" aria-labelledby="hero-title">
    <Photo id="valley-cascade" lang={lang} widths={[640, 1024, 1600]} sizes="100vw" eager class="hero-photo" />
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <p class="eyebrow">{text.hero.eyebrow}</p>
      <h1 id="hero-title">{text.hero.title}</h1>
      <p class="hero-lead">{text.hero.lead}</p>
      <div class="actions">
        <a class="button" href="#ways">{text.hero.discover}</a>
        <a class="button ghost" href={visit}>{text.hero.visit}</a>
      </div>
    </div>
  </section>

  <section id="ways" class="band" aria-labelledby="ways-title">
    <div class="wrap">
      <header class="band-head">
        <h2 id="ways-title">{text.ways.title}</h2>
        <p class="lead">{text.ways.lead}</p>
      </header>
      <ul class="ways">
        {
          ways.map((way) => (
            <li>
              <a class="way" href={`${attractions}#${way.kind}`}>
                <Photo id={way.photo} lang={lang} widths={[440, 640]} sizes="(min-width: 76rem) 24rem, (min-width: 52rem) 31vw, 92vw" decorative />
                <span class="way-text">
                  <strong>{t(lang, `kind.${way.kind}`)}</strong>
                  <span>{way.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-photo">
        <Photo id="border-view" lang={lang} widths={[560, 720]} sizes="(min-width: 76rem) 34rem, (min-width: 60rem) 45vw, 92vw" />
      </div>
      <div>
        <p class="eyebrow">{text.story.eyebrow}</p>
        <h2 id="story-title">{text.story.title}</h2>
        <ol class="steps">
          {
            text.story.steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <p class="source">
                  {text.sourceLabel}: <a href={sources[step.source].url}>{sources[step.source].title}</a>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="featured-title">
    <div class="wrap">
      <header class="band-head split">
        <h2 id="featured-title">{text.featured.title}</h2>
        <a class="more-link" href={attractions}>{text.featured.all} →</a>
      </header>
      <ul class="cards">
        {featured.map((entry) => <ItemCard entry={entry} collection="attractions" lang={lang} />)}
      </ul>
    </div>
  </section>

  <section class="band seasons" aria-labelledby="seasons-title">
    <div class="wrap seasons-grid">
      <div>
        <h2 id="seasons-title">{text.seasons.title}</h2>
        <p class="lead">{text.seasons.lead}</p>
        <dl class="season-list">
          <div>
            <dt>{text.seasons.wet.title}</dt>
            <dd>{text.seasons.wet.text}</dd>
          </div>
          <div>
            <dt>{text.seasons.dry.title}</dt>
            <dd>{text.seasons.dry.text}</dd>
          </div>
        </dl>
        <p class="source">
          {text.sourceLabel}: <a href={sources[text.seasons.source].url}>{sources[text.seasons.source].title}</a>
        </p>
      </div>
      <div class="seasons-photo">
        <Photo id="river-summer" lang={lang} widths={[560, 720]} sizes="(min-width: 76rem) 34rem, (min-width: 60rem) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <section class="band getting" aria-labelledby="getting-title">
    <div class="wrap">
      <header class="band-head">
        <h2 id="getting-title">{text.getting.title}</h2>
        <p class="lead">{text.getting.lead}</p>
      </header>
      <ul class="getting-list">
        {
          getting.map((way) => (
            <li>
              <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
                <path d={way.icon} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <h3>{way.title}</h3>
              <p>{way.text}</p>
              <p class="source">
                {text.sourceLabel}: <a href={sources[way.source].url}>{sources[way.source].title}</a>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="actions">
        <a class="button" href={visit}>{text.getting.more} →</a>
      </p>
    </div>
  </section>

  <PhotoCredits ids={shown} lang={lang} />
</BaseLayout>
