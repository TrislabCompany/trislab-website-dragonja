---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StructuredData from "../components/StructuredData.astro";
import Analytics from "../components/analytics/Analytics.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import type { ShareImage } from "../components/seo/types";
import { languages, t, unlocalizedPath, type Lang } from "../i18n";
import site from "../site.config";
import "../styles/tokens.css";
import "../styles/global.css";
// The Latin subset of the font in src/styles/tokens.css, loaded early so text is drawn once, in it.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import type { ComponentProps } from "astro/types";
import { getImage } from "astro:assets";
import PlaceData from "../components/PlaceData.astro";
import { photo } from "../lib/photos";

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** The languages this page exists in; by default all of them. */
  available?: readonly Lang[];
  /** Leave the page out of search engines and the sitemap (the 404 page). */
  noindex?: boolean;
  /** A full-width page (the home page): the header lies over its first section. */
  wide?: boolean;
  /** The photo id shared on social media; by default the valley. */
  share?: string;
  /** A picture shared instead of the photo `share` names (an item's shareImage). */
  image?: ShareImage;
  /** Structured data for the page's place, with the share photo as its image. */
  place?: Omit<ComponentProps<typeof PlaceData>, "image">;
}

const {
  title,
  description,
  lang,
  available = languages,
  noindex,
  wide = false,
  share = "valley-cascade",
  image,
  place,
} = Astro.props;
// The share picture: SeoHead writes its tags; the place's structured data
// uses the same 1200 × 630 crop, which the build writes once.
const shareImage: ShareImage = image ?? { src: photo(share).src, alt: photo(share).alt };
const shareCrop = await getImage({ src: shareImage.src, width: 1200, height: 630, fit: "cover", format: "jpg" });

// The page without its language prefix, for the language switch.
const path = unlocalizedPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SeoHead title={title} description={description} lang={lang} available={available} noindex={noindex} image={shareImage} />
    <meta name="theme-color" content={site.themeColor} />
    <StructuredData />
    {place && <PlaceData {...place} image={shareCrop.src} />}
    {site.analytics && <Analytics />}
  </head>
  <body class={wide ? "wide" : undefined}>
    <a class="skip-link" href="#main">{t(lang, "nav.skip")}</a>
    <Header lang={lang} path={path} available={available} overlay={wide} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
