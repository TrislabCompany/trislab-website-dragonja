---
import { localizedPath, t, type Lang } from "../i18n";
import site from "../site.config";
import EnvironmentBadge from "./EnvironmentBadge.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pages = [
  ...site.collections.filter((collection) => collection.nav).map((collection) => ({ href: `/${collection.id}`, label: collection.title[lang] })),
  { href: "/about", label: t(lang, "nav.about") },
  { href: "/contact", label: t(lang, "nav.contact") },
];
const legal = [
  { on: site.legalPages.imprint, href: "/imprint", label: t(lang, "legal.imprint") },
  { on: site.legalPages.privacy, href: "/privacy", label: t(lang, "legal.privacy") },
  { on: site.legalPages.accessibility, href: "/accessibility", label: t(lang, "legal.accessibility") },
  { on: site.legalPages.sustainability, href: "/sustainability", label: t(lang, "legal.sustainability") },
  { on: true, href: "/sitemap", label: t(lang, "legal.sitemap") },
].filter((link) => link.on);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-about">
      <a class="brand" href={localizedPath(lang)}>
        <Logo size={44} place="footer" />
        <span>{site.name}</span>
      </a>
      <p>{site.description[lang]}</p>
    </div>
    <nav class="footer-links" aria-label={t(lang, "nav.footer")}>
      {pages.map(({ href, label }) => <a href={localizedPath(lang, href)}>{label}</a>)}
    </nav>
    {
      legal.length > 0 && (
        <nav class="footer-links" aria-label={t(lang, "legal.nav")}>
          {legal.map(({ href, label }) => (
            <a href={localizedPath(lang, href)}>{label}</a>
          ))}
        </nav>
      )
    }
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} {site.company.legalName}. {t(lang, "footer.noCookies")}</span>
    <EnvironmentBadge />
  </div>
</footer>
