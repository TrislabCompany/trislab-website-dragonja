---
// The site header. On the home page it lies over the hero photo (`overlay`).
// On a phone the links fold into a menu built on <details>: it opens without
// JavaScript. The wide navigation and the menu hold the same links; CSS shows
// one of them.
import { localizedPath, t, type Lang } from "../i18n";
import site from "../site.config";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  path: string;
  available?: readonly Lang[];
  overlay?: boolean;
}

const { lang, path, available, overlay = false } = Astro.props;
// The lists of items marked nav in src/site.config.ts, then the fixed pages.
const links = [
  ...site.collections.filter((collection) => collection.nav).map((collection) => ({ href: `/${collection.id}`, label: collection.title[lang] })),
  { href: "/about", label: t(lang, "nav.about") },
  { href: "/contact", label: t(lang, "nav.contact") },
];
// A section's link stays marked on its detail pages (/attractions/padna).
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={["site-header", { overlay }]}>
  <div class="wrap header-row">
    <a class="brand" href={localizedPath(lang)}>
      <Logo />
      <span>{site.name}</span>
    </a>
    <nav class="main-nav" aria-label={t(lang, "nav.main")}>
      {
        links.map(({ href, label }) => (
          <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitch lang={lang} path={path} available={available} />
    <details class="menu">
      <summary>
        <span class="menu-icon" aria-hidden="true"></span>
        {t(lang, "nav.menu")}
      </summary>
      <nav class="menu-panel" aria-label={t(lang, "nav.main")}>
        {
          links.map(({ href, label }) => (
            <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
        <LanguageSwitch lang={lang} path={path} available={available} />
      </nav>
    </details>
  </div>
</header>
